{
  "name": "biblioteka-jozzpoly",
  "version": "2.0.0",
  "private": true,
  "description": "Generator Biblioteki Jozzpoly: python3 -I tools/regen.py",
  "scripts": {
    "regen": "python3 -I tools/regen.py",
    "regen:web": "python3 -I tools/regen.py --host web",
    "check": "python3 -I tools/regen.py --no-fetch --shoot",
    "jaskinia": "python3 tools/render.py --app jaskinia && python3 tools/render.py --app jaskinia --host web",
    "jaskinia:test": "node tools/jk_test.mjs",
    "jaskinia:test2": "node tools/jk2_test.mjs",
    "jaskinia:look": "node tools/jk2_look.mjs",
    "jaskinia:chaos": "node tools/jk2_chaos.mjs 400 7"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/recursive": "5.3.0"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  }
}